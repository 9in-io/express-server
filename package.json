{
  "name": "@9in-io/express-server",
  "version": "3.1.0",
  "description": "Keep your users in your own database and sign them in with 9in: an Express router for adapter protocol v2 (authenticate, user, event) with OTP delivery and event channels.",
  "keywords": [
    "9in",
    "sso",
    "express",
    "adapter",
    "oauth2",
    "openid-connect",
    "authentication"
  ],
  "license": "MIT",
  "author": "9in <support@9in.io>",
  "homepage": "https://9in.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9in-io/express-server.git"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/templates','build/templates',{recursive:true})\"",
    "test": "jest --verbose"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@9in-io/node": "^4.1.0"
  },
  "peerDependencies": {
    "express": "^4.21.2 || ^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "express": "^5.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  }
}
