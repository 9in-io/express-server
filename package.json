    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dynalite": "^3.2.2",
