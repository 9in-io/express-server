{
  "name": "@9in-io/express-server",
  "version": "4.0.0",
  "description": "Keep your users in your own database and sign them in with 9in: an Express router for adapter protocol v2, with ready-made user stores for Prisma, SQL, MongoDB, Mongoose and DynamoDB.",
  "keywords": [
    "9in",
    "adapter",
    "authentication",
    "dynamodb",
    "express",
    "mongodb",
