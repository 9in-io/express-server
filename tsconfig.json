{
    "include": ["src"],
    "exclude": ["src/__test__", "build"],
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2023", "dom"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "src/",
        "outDir": "build",
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node"]
    }
}
